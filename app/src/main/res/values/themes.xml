<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Base application theme. -->
    <style name="BaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
    </style>

    <!-- Inherit base theme to allow overriding Light Theme as per API levels -->
    <style name="Theme.Etar" parent="BaseTheme">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ShineFlow dopamine color overlays (applied at runtime over Theme.Etar) -->
    <style name="ThemeOverlay.ShineFlow.Coral" parent="">
        <item name="colorPrimary">@color/sf_coral</item>
        <item name="colorAccent">@color/sf_coral</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_coral_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_coral_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_coral_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_coral_on_container</item>
    </style>

    <style name="ThemeOverlay.ShineFlow.Mango" parent="">
        <item name="colorPrimary">@color/sf_mango</item>
        <item name="colorAccent">@color/sf_mango</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_mango_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_mango_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_mango_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_mango_on_container</item>
    </style>

    <style name="ThemeOverlay.ShineFlow.Grape" parent="">
        <item name="colorPrimary">@color/sf_grape</item>
        <item name="colorAccent">@color/sf_grape</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_grape_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_grape_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_grape_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_grape_on_container</item>
    </style>

    <style name="ThemeOverlay.ShineFlow.Mint" parent="">
        <item name="colorPrimary">@color/sf_mint</item>
        <item name="colorAccent">@color/sf_mint</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_mint_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_mint_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_mint_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_mint_on_container</item>
    </style>

    <style name="ThemeOverlay.ShineFlow.Sky" parent="">
        <item name="colorPrimary">@color/sf_sky</item>
        <item name="colorAccent">@color/sf_sky</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_sky_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_sky_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_sky_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_sky_on_container</item>
    </style>

    <style name="ThemeOverlay.ShineFlow.Bubblegum" parent="">
        <item name="colorPrimary">@color/sf_bubblegum</item>
        <item name="colorAccent">@color/sf_bubblegum</item>
        <item name="colorOnPrimary">@color/sf_white</item>
        <item name="colorPrimaryContainer">@color/sf_bubblegum_container</item>
        <item name="colorOnPrimaryContainer">@color/sf_bubblegum_on_container</item>
        <item name="colorSecondaryContainer">@color/sf_bubblegum_container</item>
        <item name="colorOnSecondaryContainer">@color/sf_bubblegum_on_container</item>
    </style>

    <style name="CalendarAppThemeLightTeal" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:itemBackground">@android:color/white</item>
        <item name="autoCompleteTextViewStyle">@style/actionbar_cursor</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled</item>
    </style>

    <style name="CalendarAppThemeDarkTeal" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:itemBackground">@color/bg_dark</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled_dark</item>
    </style>

    <style name="CalendarAppThemeBlackTeal" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/bg_black</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:itemBackground">@color/bg_black</item>
        <item name="calendarSpinnerDisabledTextColor">@color/calendar_item_disabled_black</item>
    </style>

</resources>
